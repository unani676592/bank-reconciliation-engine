# Copy this file to .env and fill in real values. .env is git-ignored.

# API key callers must send in the x-api-key header. Choose a long random string.
RECON_API_KEY=

# Supabase project REST endpoint, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key (server-side only, bypasses RLS). Never expose to clients.
SUPABASE_SERVICE_KEY=
